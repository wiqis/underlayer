# build_samples.sh is the single source of truth. It writes the .c files and
# every version script itself, so they are build products.
#
#   ./build_samples.sh     # writes specimens, builds, prints each finding
#   python3 crosscheck.py  # asserts all 85 load-bearing claims
#   python3 dynscope.py    # the buildable artifact
#
# Tracked: build_samples.sh, crosscheck.py, dynscope.py
__pycache__/

# generated C sources
*.c

# version scripts, generated by the build script
*.map

# objects
*.o

# shared libraries and executables. They have no extension, so naming them
# here is unavoidable. Everything is disposable: ./build_samples.sh
# recreates all of it from an empty directory.
*.so
prog
prog2
prog3
order
liba.so
libb.so
libc1.so
libd2.so
libdeep.so
libself.so
libself_sym.so
libb_sym.so
libplug.so
liblazy.so
libself.so
libself_sym.so
vis_*.so
t_plain
t_symbolic
t_lib*
dl
dl0
dlprog
lazy
lazy_now
tv
tv2_*

# extensionless executables from the later findings. The build script writes
# every one of these, so they are products, and ./build_samples.sh recreates
# all of them from an empty directory.
dbad
late2
twice
tt
tlsmain
order
order_shim
order_shim2
s_plain.o
s_nosem.o
s_sym.o
f_plain.o
f_sym.o
