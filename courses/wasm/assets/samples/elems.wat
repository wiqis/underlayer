(module
  (table $a 4 funcref)
  (table $b 4 funcref)
  (table $c 4 funcref)
  (table $d 4 funcref)
  (table $e 4 funcref)
  (func $f0) (func $f1) (func $f2)
  (type $t (func))
  (elem (i32.const 0) $f0 $f1)
  (elem (table $b) (i32.const 1) func $f2)
  (elem declare func $f0)
  (elem funcref (ref.func $f0) (ref.func $f1))
  (elem (table $e) (offset (i32.const 2)) funcref)
)
